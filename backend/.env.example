# AI 换装后端环境变量配置示例
# 复制为 .env 文件后填入对应模型的 Key：
# cp .env.example .env

# OpenAI GPT-Image-2 (官方生图模型)
OPENAI_API_KEY=sk-xxxx

# 豆包 Seedream (火山方舟，国内免翻墙首选)
ARK_API_KEY=xxxx

# Google Gemini (Nano Banana 2)
GEMINI_API_KEY=AIzaSyxxxx

# 通义万相 / 阿里百炼
DASHSCOPE_API_KEY=sk-xxxx

# 后端访问鉴权 Token（至少 32 个字符，多个以英文逗号分隔；当 security.authRequired: true 时必须配置）
TRYON_API_KEYS=your-secret-backend-token-with-at-least-32-chars,another-backend-token-for-authorized-client-32

# X（Twitter）OAuth 应用凭据（仅分享试穿结果需要；Bearer/用户 Token 也可在浏览器设置中填写）
# 在 https://developer.x.com 创建 App 后填入；切勿提交真实值到 Git
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/x/oauth/callback
